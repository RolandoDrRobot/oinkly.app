# Supabase Configuration
# Copia este archivo a .env y reemplaza los valores con tus credenciales de Supabase

# URL de tu proyecto Supabase
# La encuentras en: Supabase Dashboard > Settings > API > Project URL
REACT_APP_SUPABASE_URL=your_supabase_project_url

# Anon/Public Key de Supabase
# La encuentras en: Supabase Dashboard > Settings > API > anon public key
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key
